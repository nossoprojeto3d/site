---
import "../styles/global.css";
import Icones from "../components/Icones.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Telas from "../components/Telas.astro";
import { LINKS, SITE_URL, TELEFONE, url } from "../data/links";

interface Props {
  titulo: string;
  descricao: string;
  atual?: "inicio" | "empresas" | "eventos" | "voce";
  /** dados do negócio pro Google (schema.org); só na página inicial */
  schema?: boolean;
  semIndice?: boolean;
}
const { titulo, descricao, atual = "inicio", schema = false, semIndice = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, "https://nossoprojeto3d.github.io").href;
const og = `${SITE_URL}assets/og/og-image.jpg`;

const negocio = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Nosso Projeto 3D",
  description: "Impressão 3D em Goiânia: brindes com logo e expositores para empresas, peças personalizadas, miniaturas e decoração.",
  url: SITE_URL,
  logo: `${SITE_URL}assets/logo.png`,
  image: og,
  telephone: TELEFONE,
  address: { "@type": "PostalAddress", addressLocality: "Goiânia", addressRegion: "GO", addressCountry: "BR" },
  areaServed: [{ "@type": "City", name: "Goiânia" }, { "@type": "Country", name: "Brasil" }],
  founder: [{ "@type": "Person", name: "Júnior" }, { "@type": "Person", name: "Thairine" }],
  sameAs: [LINKS.contato.instagram, LINKS.hub.shopee, LINKS.catalogo.site]
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <!-- aplica o tema salvo antes de pintar a página (padrão: escuro) -->
  <script is:inline>
    try { if (localStorage.getItem("nossoprojeto3d-tema") === "claro") document.documentElement.dataset.tema = "claro"; } catch (e) {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{titulo}</title>
  <meta name="description" content={descricao}>
  <meta name="theme-color" content="#0E0B07" id="cor-tema">
  {semIndice ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonica}>}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Nosso Projeto 3D">
  <meta property="og:url" content={canonica}>
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descricao}>
  <meta property="og:image" content={og}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Logo NP dourado ao lado da frase: Ideias que ganham forma, camada por camada.">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={url("assets/icons/favicon.ico")} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={url("assets/icons/favicon-32.png")}>
  <link rel="apple-touch-icon" href={url("assets/icons/apple-touch-icon.png")}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap">
  {schema && <script type="application/ld+json" set:html={JSON.stringify(negocio)} />}
  <script is:inline src={url("assets/medicao.js")} defer></script>
</head>
<body data-medir-secoes>
  <a href="#topo" class="pular">Pular para o conteúdo</a>
  <Icones />
  <Nav atual={atual} />
  <main id="topo" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <Telas />
  <slot name="fim" />
  <script>
    // topo ganha fundo ao rolar
    const nav = document.getElementById("nav")!;
    const aoRolar = () => nav.classList.toggle("scrolled", scrollY > 8);
    aoRolar();
    addEventListener("scroll", aoRolar, { passive: true });

    // tema claro/escuro: salvo no navegador e com a mesma escolha em todas as páginas
    const html = document.documentElement;
    const corTema = document.getElementById("cor-tema") as HTMLMetaElement;
    const botoes = document.querySelectorAll<HTMLButtonElement>("[data-tema-alternar]");
    const aplicar = (claro: boolean) => {
      if (claro) html.dataset.tema = "claro"; else delete html.dataset.tema;
      corTema.content = claro ? "#F5F1E8" : "#0E0B07";
      botoes.forEach((b) => b.setAttribute("aria-label", claro ? "Usar tema escuro" : "Usar tema claro"));
    };
    aplicar(html.dataset.tema === "claro");
    botoes.forEach((b) => b.addEventListener("click", () => {
      const claro = html.dataset.tema !== "claro";
      html.classList.add("trocando-tema");
      aplicar(claro);
      try { localStorage.setItem("nossoprojeto3d-tema", claro ? "claro" : "escuro"); } catch {}
      window.np3dTrack?.("trocar_tema", { tema: claro ? "claro" : "escuro" });
      setTimeout(() => html.classList.remove("trocando-tema"), 450);
    }));
  </script>
</body>
</html>
