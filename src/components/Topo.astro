---
// Abertura das páginas de caminho (empresas, eventos, você): rótulo, título grande, apoio e botões.
// Conteúdo extra logo abaixo (ex.: vitrine) vai no slot "depois".
interface Props { rotulo: string; titulo: string; texto: string }
const { rotulo, titulo, texto } = Astro.props;
---
<section class="topo">
  <div class="container">
    <span class="eyebrow">{rotulo}</span>
    <h1>{titulo}</h1>
    <p class="lead">{texto}</p>
    <div class="ctas"><slot /></div>
  </div>
  <slot name="depois" />
</section>

<style>
  .topo{padding:72px 0 120px;background:radial-gradient(ellipse 60% 70% at 85% 0%,var(--gold-dim),transparent 70%);}
  h1{margin-top:26px;font-size:var(--fs-hero);line-height:1;font-weight:300;max-width:14ch;}
  .lead{margin-top:28px;max-width:540px;font-size:var(--fs-lead);line-height:1.6;color:var(--body);}
  .ctas{margin-top:40px;}
  @media (max-width:760px){ .topo{padding:40px 0 80px;} }
</style>
