---
// Barra fixa no celular: aparece depois do topo da página e some quando o orçamento já está na tela.
interface Props { texto: string }
const { texto } = Astro.props;
---
<div class="barra" id="barra-orc" aria-hidden="true">
  <div class="barra-in">
    <p>{texto}</p>
    <a href="#orcamento" class="btn btn-primary facet" tabindex="-1"><svg width="17" height="17" aria-hidden="true"><use href="#i-whatsapp"/></svg>Pedir orçamento</a>
  </div>
</div>

<style>
  .barra{display:none;}
  @media (max-width:760px){
    .barra{display:block;position:fixed;left:0;right:0;bottom:0;z-index:60;padding:10px var(--gutter) calc(10px + env(safe-area-inset-bottom,0px));
      background:var(--vidro);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-top:1px solid var(--line-2);
      transform:translateY(110%);transition:transform .4s var(--ease);}
    .barra:global(.on){transform:none;}
    /* o aviso de cookies tem prioridade lá embaixo */
    :global(body:has(#np3d-cookies)) .barra{transform:translateY(110%);}
    .barra-in{display:flex;align-items:center;gap:12px;}
    p{display:none;}
    .btn{flex:1;height:48px;}
  }
</style>

<script>
  const barra = document.getElementById("barra-orc")!;
  const alvo = document.getElementById("orcamento");
  let passouTopo = false, vendoOrc = false;
  const aplicar = () => {
    const on = passouTopo && !vendoOrc;
    barra.classList.toggle("on", on);
    barra.setAttribute("aria-hidden", String(!on));
    barra.querySelector("a")!.tabIndex = on ? 0 : -1;
  };
  addEventListener("scroll", () => { passouTopo = scrollY > innerHeight * 0.6; aplicar(); }, { passive: true });
  if (alvo) new IntersectionObserver(([e]) => { vendoOrc = e.isIntersecting; aplicar(); }, { threshold: 0.05 }).observe(alvo);
</script>
