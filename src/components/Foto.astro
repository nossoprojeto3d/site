---
// Foto do site, sempre em 4:5 (1080×1350). Procura public/assets/fotos/<arquivo>.jpg na hora do build:
// se o arquivo existe, mostra a foto; se não, mostra "Foto em breve". O número do espaço fica em
// data-espaco (veja no inspetor) e a lista completa está nos "fotos:" das páginas.
import fs from "node:fs";
import path from "node:path";
import { url } from "../data/links";

interface Props { arquivo: string; descricao: string; class?: string }
const { arquivo, descricao, class: classe } = Astro.props;
const existe = fs.existsSync(path.join(process.cwd(), "public/assets/fotos", `${arquivo}.jpg`));
const numero = arquivo.split("-")[0];
---
{existe ? (
  <div class:list={["foto", "foto-real", classe]}>
    <img src={url(`assets/fotos/${arquivo}.jpg`)} alt={descricao} width="1080" height="1350" loading="lazy" decoding="async">
  </div>
) : (
  <div class:list={["foto", "foto-breve", classe]} role="img" aria-label={`Foto em breve: ${descricao}`} data-espaco={numero}>
    <span class="breve" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13.5" r="3.5"/></svg>
      Foto em breve
    </span>
  </div>
)}

<style>
  .foto-real img{width:100%;height:100%;object-fit:cover;display:block;}
  .foto-breve{align-items:center;justify-content:center;}
  .breve{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:12px;
    font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--faint);}
  .breve svg{color:var(--gold);opacity:.8;}
  /* uma camada dourada subindo devagar, como uma peça sendo impressa */
  /* camada do tamanho da foto com a linha no pé; sobe com transform (barato pro navegador) */
  .foto-breve::after{content:"";position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(90deg,transparent,var(--gold) 30%,var(--gold-2) 50%,var(--gold) 70%,transparent) bottom/100% 1px no-repeat;
    filter:drop-shadow(0 0 6px var(--gold-dim));opacity:0;animation:camada 7s linear infinite;}
  @keyframes camada{0%{transform:translateY(0);opacity:0;}8%,92%{opacity:.6;}100%{transform:translateY(-100%);opacity:0;}}
  @media (prefers-reduced-motion:reduce){ .foto-breve::after{display:none;} }
</style>
