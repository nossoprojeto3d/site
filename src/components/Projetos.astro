---
// Nossos projetos: lojas, rede e ferramentas que fazemos, em lista.
// Passar o mouse numa linha apaga as outras e empurra a seta (inspirado no "Project Index" do 21st.dev).
import { LINKS } from "../data/links";

const projetos = [
  { tipo: "Rede", nome: "Instagram", texto: "Bastidores, lançamentos e novidades em @nossoprojeto3d.", href: LINKS.contato.instagram, link: "contato.instagram", icone: "i-instagram" },
  { tipo: "Loja", nome: "Catálogo", texto: "Peças com preço e cores, pedidas pelo WhatsApp.", href: LINKS.catalogo.site, link: "catalogo.site", icone: "i-book" },
  { tipo: "Loja", nome: "Shopee", texto: "Nossos produtos com a segurança da plataforma.", href: LINKS.hub.shopee, link: "hub.shopee", icone: "i-bag" },
  { tipo: "Ferramenta", nome: "Calculadora de custos", texto: "Calcule o custo real das suas impressões 3D.", href: LINKS.calculadora.site, link: "calculadora.site", icone: "i-calc" },
  { tipo: "Ferramenta", nome: "Ajuste 3MF", texto: "A IA sugere as configurações do seu 3MF para o Bambu Studio.", href: LINKS.ajuste3mf.site, link: "ajuste3mf.site", icone: "i-sliders" },
  { tipo: "Download", nome: "STLs grátis", texto: "Arquivos prontos para você imprimir em casa.", href: LINKS.hub.stlsGratis, link: "hub.stlsGratis", icone: "i-cube" }
];
---
<section class="sec projetos" id="projetos" aria-labelledby="projetos-titulo">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">Nossos projetos</span>
      <h2 id="projetos-titulo">Tudo o que a gente faz, num lugar só.</h2>
      <p>Onde comprar, onde acompanhar e as ferramentas que criamos para quem também imprime em 3D.</p>
    </div>
    <ul class="lista">
      {projetos.map((p) => (
        <li>
          <a href={p.href} data-link={p.link} target="_blank" rel="noopener noreferrer">
            <span class="ic"><svg width="20" height="20" aria-hidden="true"><use href={`#${p.icone}`}/></svg></span>
            <span class="nome">{p.nome}</span>
            <span class="texto">{p.texto}</span>
            <span class="tipo">{p.tipo}</span>
            <svg class="seta" width="20" height="20" aria-hidden="true"><use href="#i-arrow"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lista{list-style:none;margin:0;padding:0;border-top:1px solid var(--line);}
  li{border-bottom:1px solid var(--line);}
  a{display:grid;grid-template-columns:44px minmax(270px,1fr) 1.5fr 110px 24px;align-items:center;gap:24px;padding:26px 8px;
    transition:opacity .35s ease,background .35s ease;}
  .ic{width:44px;height:44px;border:1px solid var(--line-2);display:flex;align-items:center;justify-content:center;color:var(--gold);transition:border-color .35s ease,transform .45s var(--ease);}
  .nome{font-family:var(--serif);font-size:clamp(22px,1.2vw + 16px,30px);line-height:1.15;color:var(--text);transition:color .3s ease;}
  .texto{font-size:var(--fs-body);color:var(--muted);line-height:1.55;}
  .tipo{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);justify-self:end;}
  .seta{color:var(--faint);transition:transform .45s var(--ease),color .3s ease;}

  /* hover: a linha ganha destaque e as outras recuam */
  .lista:has(a:hover) a:not(:hover){opacity:.38;}
  a:hover,a:focus-visible{background:linear-gradient(90deg,var(--gold-dim),transparent 70%);}
  a:hover .nome,a:focus-visible .nome{color:var(--gold-2);}
  a:hover .ic,a:focus-visible .ic{border-color:var(--gold);transform:rotate(-6deg);}
  a:hover .seta,a:focus-visible .seta{color:var(--gold-2);transform:translate(4px,-4px);}

  @media (max-width:980px){
    a{grid-template-columns:44px 1fr 24px;column-gap:18px;row-gap:4px;padding:20px 4px;}
    .ic{grid-row:span 2;}
    .nome{grid-column:2;}
    .texto{grid-column:2;grid-row:2;}
    .tipo{display:none;}
    .seta{grid-column:3;grid-row:1 / span 2;}
  }
  @media (hover:none){ .lista:has(a:hover) a:not(:hover){opacity:1;} }
</style>
