---
// Onde atendemos: mapa do Brasil com Goiânia e região em destaque e rotas de envio até as capitais.
// As rotas se desenham quando a seção entra na tela; pacotes e o caminhão andam com <animateMotion>.
// Com "reduzir movimento" o mapa aparece pronto e parado.
import { LARGURA, ALTURA, contorno, goiania, raioRegiao, rotas } from "../data/mapa";
const [gx, gy] = goiania;
// dois caminhões, em rotas pro leste (o ícone não gira, então nunca anda de ré)
const rotasCaminhao = rotas.filter((r) => r.nome === "Recife" || r.nome === "São Paulo").map((r) => r.d);
---
<section class="sec entrega" id="entrega" aria-labelledby="entrega-titulo">
  <div class="container entrega-grid">
    <div class="entrega-txt">
      <span class="eyebrow">Onde atendemos</span>
      <h2 id="entrega-titulo">De Goiânia para todo o Brasil.</h2>
      <p>Produzimos tudo aqui em Goiânia. Daqui, a peça segue até você, more onde morar.</p>
      <dl class="entrega-lista">
        <div>
          <dt><span class="ponto ponto-regiao" aria-hidden="true"></span>Goiânia e região</dt>
          <dd class="ph">Entrega ou retirada combinada pelo WhatsApp.</dd>
        </div>
        <div>
          <dt><span class="ponto ponto-rota" aria-hidden="true"></span>Todo o Brasil</dt>
          <dd>Enviamos com segurança e qualidade pelas principais transportadoras do Brasil.</dd>
        </div>
      </dl>
    </div>

    <figure class="mapa">
      <svg viewBox={`0 0 ${LARGURA} ${ALTURA}`} role="img" aria-labelledby="mapa-desc">
        <desc id="mapa-desc">Mapa do Brasil com Goiânia em destaque e rotas de envio saindo de Goiânia para as capitais do país.</desc>
        <defs>
          <pattern id="pontos" width="9" height="9" patternUnits="userSpaceOnUse">
            <circle cx="4.5" cy="4.5" r="1.25" />
          </pattern>
          <clipPath id="recorte-brasil"><path d={contorno} /></clipPath>
          <radialGradient id="brilho-regiao">
            <stop offset="0" stop-color="#E8C873" stop-opacity=".45" />
            <stop offset="1" stop-color="#C9A227" stop-opacity="0" />
          </radialGradient>
          <g id="caminhao">
            <rect x="-11" y="-6" width="13" height="9" rx="1" />
            <path d="M2 -3h5l3 3v3H2z" />
            <circle cx="-7" cy="4" r="2" class="roda" /><circle cx="6" cy="4" r="2" class="roda" />
          </g>
        </defs>

        <rect width={LARGURA} height={ALTURA} fill="url(#pontos)" clip-path="url(#recorte-brasil)" class="mapa-pontos" />
        <path d={contorno} class="mapa-contorno" />

        <g class="rotas">
          {rotas.map((r, i) => (
            <path d={r.d} pathLength="1" class="rota" style={`--i:${i}`} />
          ))}
        </g>

        <g class="pacotes">
          {rotas.map((r, i) => (
            <circle r="2.6" class="pacote">
              <animateMotion dur={`${3.2 + (i % 4) * 0.5}s`} begin={`-${(i * 0.37).toFixed(2)}s`} repeatCount="indefinite" path={r.d} keyPoints="0;1" keyTimes="0;1" calcMode="linear" />
            </circle>
          ))}
        </g>

        <g class="destinos">
          {rotas.map((r) => <circle cx={r.x} cy={r.y} r="3.2" class="destino" />)}
        </g>

        <g class="regiao">
          <circle cx={gx} cy={gy} r={raioRegiao * 1.6} fill="url(#brilho-regiao)" />
          <circle cx={gx} cy={gy} r={raioRegiao} class="regiao-borda" />
          <circle cx={gx} cy={gy} r={raioRegiao} class="onda" />
          <circle cx={gx} cy={gy} r={raioRegiao} class="onda onda-2" />
          <circle cx={gx} cy={gy} r="5.5" class="sede" />
          <text x={gx + raioRegiao + 10} y={gy + 4} class="rotulo rotulo-sede">Goiânia</text>
        </g>

        {rotasCaminhao.map((d, i) => (
          <use href="#caminhao" class="caminhao">
            <animateMotion dur="5s" begin={`-${i * 2.5}s`} repeatCount="indefinite" path={d} />
          </use>
        ))}
      </svg>
    </figure>
  </div>
</section>

<style>
  .entrega-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:center;}
  h2{margin-top:18px;font-size:var(--fs-h2);line-height:1.08;}
  .entrega-txt > p{margin-top:18px;font-size:var(--fs-body-lg);line-height:1.7;color:var(--muted);max-width:440px;}
  .entrega-lista{margin:40px 0 0;display:grid;gap:22px;}
  .entrega-lista div{border-top:1px solid var(--line);padding-top:18px;}
  dt{display:flex;align-items:center;gap:12px;font-size:var(--fs-body-lg);color:var(--text);font-weight:500;}
  dd{margin:8px 0 0 24px;color:var(--muted);font-size:var(--fs-body);line-height:1.6;}
  .ponto{width:12px;height:12px;border-radius:50%;flex:0 0 12px;}
  .ponto-regiao{background:var(--gold-2);box-shadow:0 0 0 4px rgba(232,200,115,.18);}
  .ponto-rota{border:1.5px dashed var(--gold);}

  .mapa{margin:0;}
  svg{width:100%;height:auto;display:block;overflow:visible;}
  #pontos circle{fill:var(--pontos-mapa);}
  .mapa-contorno{fill:none;stroke:var(--line-2);stroke-width:1;}

  .rota{fill:none;stroke:var(--gold);stroke-width:1.2;stroke-linecap:round;opacity:.75;
    stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.6s var(--ease) calc(var(--i) * 90ms);}
  .entrega:global(.on) .rota{stroke-dashoffset:0;}
  .pacote{fill:var(--gold-2);filter:drop-shadow(0 0 4px rgba(232,200,115,.9));opacity:0;transition:opacity .6s ease 1.4s;}
  .entrega:global(.on) .pacote{opacity:1;}
  .destino{fill:var(--bg);stroke:var(--gold);stroke-width:1.4;}
  /* contorno da cor do fundo pra o nome não brigar com as rotas */
  .rotulo{font-family:var(--mono);font-size:11px;letter-spacing:.06em;fill:var(--muted);paint-order:stroke;stroke:var(--bg);stroke-width:4px;stroke-linejoin:round;}
  .rotulo-sede{font-size:13px;fill:var(--gold-2);font-weight:500;}

  .regiao-borda{fill:rgba(201,162,39,.10);stroke:var(--gold-2);stroke-width:1;stroke-dasharray:3 3;}
  .sede{fill:var(--gold-2);stroke:var(--bg);stroke-width:2;filter:drop-shadow(0 0 8px rgba(232,200,115,.9));}
  .onda{fill:none;stroke:var(--gold-2);stroke-width:1;transform-box:fill-box;transform-origin:center;opacity:0;animation:onda 3s ease-out infinite;}
  .onda-2{animation-delay:1.5s;}
  @keyframes onda{0%{transform:scale(.25);opacity:.9;}100%{transform:scale(1.9);opacity:0;}}

  .caminhao{fill:var(--gold-2);opacity:0;transition:opacity .6s ease 2s;}
  .caminhao :global(.roda){fill:var(--bg);stroke:var(--gold-2);stroke-width:1.2;}
  .entrega:global(.on) .caminhao{opacity:1;}

  @media (max-width:980px){
    .entrega-grid{grid-template-columns:1fr;gap:40px;}
    .mapa{max-width:560px;width:100%;margin:0 auto;}
  }
  @media (prefers-reduced-motion:reduce){
    .rota{stroke-dashoffset:0;transition:none;}
    .pacote,.caminhao,.onda{display:none;}
  }
</style>

<script>
  // rotas se desenham quando o mapa aparece; as animações do SVG só rodam enquanto ele está na tela
  const secao = document.getElementById("entrega")!;
  const svg = secao.querySelector("svg")!;
  const parado = matchMedia("(prefers-reduced-motion: reduce)").matches;
  svg.pauseAnimations();
  new IntersectionObserver(([e]) => {
    if (e.isIntersecting) secao.classList.add("on");
    if (parado) return;
    e.isIntersecting ? svg.unpauseAnimations() : svg.pauseAnimations();
  }, { threshold: 0.25 }).observe(svg);
</script>
