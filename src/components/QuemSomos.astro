---
import Foto from "./Foto.astro";
// Resumo de quem somos, no fim da página inicial. A história completa abre em tela (Telas.astro).
---
<section class="sec quem" aria-labelledby="quem-titulo">
  <div class="container quem-grid">
    <Foto arquivo="01-casal" descricao="Júnior e Thairine com a impressora" class="surge" />
    <div class="surge">
      <span class="eyebrow">Quem somos</span>
      <h2 id="quem-titulo">Um casal construindo juntos, com propósito e fé, um negócio feito com cuidado em cada camada.</h2>
      <p>Júnior é engenheiro de software e Thairine é arquiteta. Cada peça passa pelas nossas mãos, do projeto ao acabamento.</p>
      <button type="button" class="btn btn-ghost facet" data-abre="historia">
        Conheça nossa história <svg width="16" height="16" aria-hidden="true"><use href="#i-right"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .quem-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:72px;align-items:center;}
  h2{margin-top:22px;font-style:italic;font-size:var(--fs-quote);line-height:1.28;}
  p{margin-top:20px;color:var(--body);line-height:1.8;font-size:var(--fs-body-lg);max-width:560px;}
  .btn{margin-top:32px;}
  @media (max-width:760px){
    .quem-grid{grid-template-columns:1fr;gap:36px;}
  }
</style>
