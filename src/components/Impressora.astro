---
// Animação do logo sendo impresso, igual à V1. Já teve "flash" no celular: ao mexer, conferir no celular.
import "../styles/_printer.css";
import { url } from "../data/links";
const logo = url("assets/logo.png");
---
<div class="printer" aria-hidden="true">
  <i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
  <span class="printer-label tl">NP—3D</span>
  <span class="printer-label tr">● Imprimindo</span>
  <span class="printer-label bl">Camada 0,20 mm</span>
  <span class="printer-label br">Goiânia · BR</span>
  <div class="printer-stage">
    <img class="printer-ghost" src={logo} alt="" width="254" height="300">
    <div class="printer-build"><img class="printer-logo" src={logo} alt="" width="254" height="300"></div>
  </div>
  <div class="printer-bed"></div>
  <div class="printer-head">
    <span class="head-rail"></span>
    <span class="head-layer"></span>
    <div class="head-x">
      <svg viewBox="0 0 48 60">
        <rect x="1" y="1" width="46" height="18" rx="1.5" fill="#18130C" stroke="#C9A227" stroke-width="1.2"/>
        <circle cx="8" cy="10" r="1.8" fill="#C9A227" opacity=".6"/><circle cx="40" cy="10" r="1.8" fill="#C9A227" opacity=".6"/>
        <path d="M15 19v13M20 19v13M24 19v13M28 19v13M33 19v13" stroke="#8C7424" stroke-width="1.4"/>
        <rect x="12" y="31" width="24" height="12" fill="#2A2012" stroke="#C9A227" stroke-width="1.2"/>
        <path d="M17 43h14l-4 10h-6Z" fill="#C9A227"/>
        <path d="M22 53h4l-1.2 4.5h-1.6Z" fill="#E8C873"/>
      </svg>
      <span class="head-glow"></span>
    </div>
  </div>
</div>

<style is:global>
  /* celular e tablet: a impressora vira uma faixa acima do título */
  @media (max-width:980px){
    .printer{--nz-from:22%;--nz-to:80%;--hx-from:40%;--hx-to:60%;--head-h:26px;max-width:none;aspect-ratio:5/2;justify-self:stretch;}
    .printer-stage{inset:20% 30% 22%;}
    .printer-bed{bottom:14%;}
    .printer-label.bl,.printer-label.br{display:none;}
  }
  :root[data-tema="claro"] .printer{background:linear-gradient(180deg,var(--bg-2),var(--bg));}
  :root[data-tema="claro"] .printer-ghost{opacity:.14;}
  @media (prefers-reduced-motion:reduce){
    .printer-build{animation:none;height:100%;}
    .printer-logo{animation:none;opacity:1;}
    .printer-head{display:none;}
    .printer-stage::before{animation:none;opacity:1;}
  }
</style>
