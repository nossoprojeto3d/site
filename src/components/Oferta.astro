---
// Um serviço em destaque: texto com lista de um lado, duas fotos do outro (alterna o lado com "inverte").
// "ph" é a linha da lista que ainda precisa ser confirmada pelos donos.
import Foto from "./Foto.astro";
export interface OfertaDados {
  id: string; titulo: string; texto: string; itens: string[]; ph?: string;
  /** [arquivo em public/assets/fotos sem .jpg, descrição] */
  fotos: [string, string][]; quer: string; botao: string;
}
interface Props { oferta: OfertaDados; inverte?: boolean }
const { oferta: o, inverte = false } = Astro.props;
---
<section class="sec oferta" id={o.id}>
  <div class:list={["container", "grade", { inverte }]}>
    <div class="txt surge">
      <h2>{o.titulo}</h2>
      <p>{o.texto}</p>
      <ul>
        {o.itens.map((t) => <li>{t}</li>)}
        {o.ph && <li class="ph">{o.ph}</li>}
      </ul>
      <a href="#orcamento" class="btn btn-primary facet" data-quer={o.quer}>{o.botao}</a>
    </div>
    <div class="fotos">
      {o.fotos.map(([arquivo, descricao]) => <Foto arquivo={arquivo} descricao={descricao} class="surge" />)}
    </div>
  </div>
</section>

<style>
  .grade{display:grid;grid-template-columns:1fr 1.15fr;gap:72px;align-items:center;}
  .inverte .fotos{order:-1;}
  h2{font-size:var(--fs-h2);line-height:1.08;}
  .txt > p{margin-top:18px;color:var(--body);line-height:1.75;font-size:var(--fs-body-lg);}
  ul{list-style:none;padding:0;margin:28px 0 0;display:grid;gap:12px;}
  li{display:flex;gap:12px;font-size:var(--fs-body);color:var(--body);line-height:1.5;}
  li::before{content:"";flex:0 0 14px;height:1px;background:var(--gold);margin-top:11px;}
  .btn{margin-top:32px;}
  .fotos{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .fotos > :global(.foto:first-child){margin-top:48px;}
  @media (max-width:980px){
    .grade{grid-template-columns:1fr;gap:40px;}
    .inverte .fotos{order:0;}
  }
  @media (max-width:760px){ .btn{width:100%;} }
</style>
