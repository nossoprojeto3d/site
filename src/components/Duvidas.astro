---
// Seção de perguntas frequentes (título à esquerda, perguntas à direita).
import Faq from "./Faq.astro";
interface Props { itens: [string, string][] }
const { itens } = Astro.props;
---
<section class="sec" id="duvidas">
  <div class="container grade">
    <div class="sec-head"><span class="eyebrow">Dúvidas</span><h2>Perguntas frequentes</h2></div>
    <Faq itens={itens} />
  </div>
</section>

<style>
  .grade{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;}
  .sec-head{margin-bottom:0;}
  @media (max-width:980px){ .grade{grid-template-columns:1fr;gap:40px;} }
</style>
