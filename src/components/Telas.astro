---
// Diálogos abertos por qualquer botão com data-abre="versiculo" ou data-abre="historia"
---
<dialog class="tela tela-verso" id="tela-versiculo" aria-labelledby="verso-titulo">
  <button type="button" class="tela-fechar" data-fecha aria-label="Fechar"><svg width="18" height="18" aria-hidden="true"><use href="#i-x"/></svg></button>
  <div class="verso" tabindex="-1" autofocus>
    <span class="eyebrow" id="verso-titulo">Provérbios 16:3</span>
    <p class="verso-texto">“Confia ao Senhor as tuas obras, e os teus <span class="gold-text">desígnios serão estabelecidos</span>.”</p>
    <p class="verso-versao">Almeida Revista e Atualizada</p>
  </div>
</dialog>

<dialog class="tela tela-historia" id="tela-historia" aria-labelledby="historia-titulo">
  <button type="button" class="tela-fechar" data-fecha aria-label="Fechar"><svg width="18" height="18" aria-hidden="true"><use href="#i-x"/></svg></button>
  <article class="historia" tabindex="-1" autofocus>
    <span class="eyebrow">Nossa história</span>
    <h2 id="historia-titulo">Somos um casal, dois sonhos e um propósito: <span class="gold-text">construir juntos</span> aquilo que Deus colocou em nossos corações.</h2>
    <div class="historia-sign"><span class="mono">J&amp;T</span><div><b>Júnior &amp; Thairine</b>Fundadores</div></div>
    <p class="lead">Somos Júnior e Thairine, um casal de empreendedores que acredita que grandes sonhos podem ser construídos juntos, com propósito, dedicação e fé.</p>
    <p>Júnior é engenheiro de software e Thairine é arquiteta. Além de nossas profissões, já construímos juntos nosso primeiro negócio, a Direto de Minas, trazendo produtos de Minas Gerais para nossa região.</p>
    <p>Agora, iniciamos um novo projeto: nosso negócio de impressão 3D. Criamos produtos personalizados, miniaturas, brinquedos, organizadores, suportes, itens de decoração e muito mais, sempre buscando transformar ideias em algo real.</p>
    <p>Mais do que vender produtos, este projeto representa um sonho que estamos construindo lado a lado: conquistar nossa casa, preparar nosso casamento e realizar outros desejos que, com apenas nossas profissões, levariam mais tempo para alcançar.</p>
    <p>Este é um negócio feito por nós, para nós, com amor, trabalho e propósito.</p>
    <blockquote>“E acima de tudo, colocamos Deus à frente de cada passo, reconhecendo que toda honra e toda glória pertencem a Ele.”</blockquote>
  </article>
</dialog>

<style>
  .tela-verso{width:min(520px,calc(100vw - 40px));max-height:calc(100dvh - 40px);margin:auto;
    background:radial-gradient(ellipse 80% 70% at 50% 0%,rgba(201,162,39,.14),transparent 70%),var(--bg-2);}
  .verso,.historia{outline:none;}
  .verso{padding:56px 48px 48px;text-align:center;}
  .verso .eyebrow{justify-content:center;}
  .verso .eyebrow::after{content:"";width:28px;height:1px;background:var(--gold);}
  .verso-texto{margin-top:28px;font-family:var(--serif);font-style:italic;font-size:var(--fs-quote);line-height:1.35;}
  .verso-versao{margin-top:24px;font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--faint);}

  /* história: tela cheia no celular, painel largo no computador */
  .tela-historia{width:min(760px,calc(100vw - 48px));max-height:calc(100dvh - 48px);margin:auto;overflow:auto;overscroll-behavior:contain;
    background:radial-gradient(ellipse 90% 40% at 50% 0%,rgba(201,162,39,.12),transparent 70%),var(--bg-2);}
  .historia{padding:72px 64px 64px;}
  .historia h2{margin-top:24px;font-style:italic;font-size:var(--fs-quote);line-height:1.28;}
  .historia-sign{margin:28px 0 40px;display:flex;align-items:center;gap:14px;font-size:14px;color:var(--muted);}
  .historia-sign b{display:block;font-family:var(--serif);font-weight:500;font-size:18px;color:var(--text);}
  .historia-sign .mono{width:52px;height:52px;border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-style:italic;color:var(--gold-2);font-size:18px;}
  .historia p{font-size:var(--fs-body-lg);line-height:1.85;color:var(--body);}
  .historia p + p{margin-top:20px;}
  .historia .lead{font-family:var(--serif);font-size:var(--fs-lead);line-height:1.55;color:var(--text);}
  .historia .lead::first-letter{font-size:3.2em;float:left;line-height:.9;padding:6px 8px 0 0;color:var(--gold);font-style:italic;}
  .historia blockquote{margin:44px 0 0;padding:28px 32px;border-left:1px solid var(--gold);background:linear-gradient(90deg,var(--gold-dim),transparent);
    font-family:var(--serif);font-style:italic;font-size:var(--fs-lead);line-height:1.55;color:var(--gold-2);}

  @media (max-width:760px){
    .verso{padding:52px 24px 36px;}
    .tela-historia{width:100vw;max-width:none;height:100dvh;max-height:none;border:0;}
    .historia{padding:64px 22px calc(48px + env(safe-area-inset-bottom,0px));}
    .historia blockquote{padding:22px 20px;}
  }
</style>

<script>
  // abre/fecha os diálogos; fecha também tocando fora e trava a rolagem do fundo
  const abrir = (id: string) => {
    const d = document.getElementById(`tela-${id}`) as HTMLDialogElement | null;
    if (!d) return;
    d.showModal();
    document.documentElement.classList.add("travado");
    if (window.np3dTrack) window.np3dTrack("abrir_tela", { tela: id });
  };
  document.addEventListener("click", (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLElement>("[data-abre]");
    if (alvo) abrir(alvo.dataset.abre!);
  });
  document.querySelectorAll<HTMLDialogElement>("dialog.tela").forEach((d) => {
    d.querySelector("[data-fecha]")?.addEventListener("click", () => d.close());
    d.addEventListener("click", (e) => {
      const r = d.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close();
    });
    d.addEventListener("close", () => document.documentElement.classList.remove("travado"));
  });
</script>
