---
import { LINKS, url } from "../data/links";
const ano = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={url()} class="brand"><img src={url("assets/logo.png")} alt="" width="254" height="300"><span>Nosso Projeto 3D</span></a>
        <p>Impressão 3D para empresas e para você. Goiânia-GO, com envio para todo o Brasil.</p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <h3>Comprar</h3>
          <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer">Catálogo</a>
          <a href={LINKS.hub.shopee} data-link="hub.shopee" target="_blank" rel="noopener noreferrer">Shopee</a>
          <a href={url("empresas/")}>Para empresas</a>
          <a href={url("eventos/")}>Para eventos</a>
          <a href={url("para-voce/")}>Para você</a>
        </div>
        <div class="footer-col">
          <h3>Para makers</h3>
          <a href={LINKS.calculadora.site} data-link="calculadora.site" target="_blank" rel="noopener noreferrer">Calculadora de custos</a>
          <a href={LINKS.ajuste3mf.site} data-link="ajuste3mf.site" target="_blank" rel="noopener noreferrer">Ajuste 3MF</a>
          <a href={LINKS.hub.stlsGratis} data-link="hub.stlsGratis" target="_blank" rel="noopener noreferrer">STLs grátis</a>
          <a href={LINKS.calculadora.github} data-link="calculadora.github" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <div class="footer-col">
          <h3>Contato</h3>
          <a href={LINKS.contato.whatsapp} data-link="contato.whatsapp" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href={LINKS.contato.instagram} data-link="contato.instagram" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {ano} Nosso Projeto 3D</span>
      <span>Feito com amor, trabalho e propósito.</span>
    </div>
  </div>
</footer>

<style>
  .footer{border-top:1px solid var(--line);padding:56px 0 calc(48px + env(safe-area-inset-bottom,0px));}
  .footer-grid{display:flex;justify-content:space-between;align-items:flex-start;gap:40px;flex-wrap:wrap;}
  .brand{display:flex;align-items:center;gap:12px;}
  .brand img{height:30px;width:auto;}
  .brand span{font-family:var(--serif);font-size:17px;}
  .footer-brand p{margin-top:16px;font-size:var(--fs-small);color:var(--muted);max-width:280px;line-height:1.6;}
  .footer-cols{display:flex;gap:64px;flex-wrap:wrap;}
  .footer-col h3{font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--faint);margin:0 0 18px;}
  .footer-col a{display:block;font-size:var(--fs-small);color:var(--body);margin-bottom:12px;transition:color .25s ease;}
  .footer-col a:hover{color:var(--gold-2);}
  .footer-bottom{margin-top:48px;padding-top:24px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12.5px;color:var(--faint);}
  @media (max-width:760px){ .footer-cols{gap:40px;} }
</style>
