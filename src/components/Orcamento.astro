---
// Orçamento guiado: as escolhas viram uma "ordem de impressão" e uma mensagem pronta no WhatsApp.
// Botões com data-quer="Brindes com logo" em qualquer lugar da página já deixam o item marcado.
import { LINKS } from "../data/links";

type Tipo = "empresa" | "pessoa" | "evento";
interface Props { quem: Tipo; titulo: string; texto: string }
const { quem, titulo, texto } = Astro.props;

// cada tipo de pedido pergunta o que importa pra ele; campos com "junto" entram na linha "Para"
const CONFIG: Record<Tipo, {
  para: string; etiqueta: string; nota: string; detalhes: string;
  grupos: { campo: string; legenda: string; opcoes: string[] }[];
  textos: { campo: string; legenda: string; placeholder: string; auto?: string; junto?: boolean }[];
}> = {
  empresa: {
    para: "Empresa", etiqueta: "Empresa", nota: "Se tiver a logo, anexe por lá.", detalhes: "Cores da marca, tamanho, data do evento…",
    grupos: [
      { campo: "Preciso de", legenda: "O que você precisa", opcoes: ["Brindes com logo", "Expositor ou display", "Placa ou letreiro", "Outra peça"] },
      { campo: "Quantidade", legenda: "Quantidade", opcoes: ["Até 20", "20 a 50", "50 a 100", "Mais de 100"] },
      { campo: "Prazo", legenda: "Prazo", opcoes: ["Sem pressa", "Em até 2 semanas", "Tenho uma data"] }
    ],
    textos: [{ campo: "Empresa", legenda: "Nome da empresa", placeholder: "Opcional", auto: "organization", junto: true }]
  },
  pessoa: {
    para: "Mim", etiqueta: "Pessoa", nota: "Se tiver foto de referência, anexe por lá.", detalhes: "Cores, tamanho, para quem é, referência…",
    grupos: [
      { campo: "Preciso de", legenda: "O que você precisa", opcoes: ["Peça personalizada", "Miniatura", "Decoração", "Organizador ou suporte", "Outra peça"] },
      { campo: "Quantidade", legenda: "Quantidade", opcoes: ["1 peça", "2 a 5", "Mais de 5"] },
      { campo: "Prazo", legenda: "Prazo", opcoes: ["Sem pressa", "Em até 2 semanas", "Tenho uma data"] }
    ],
    textos: []
  },
  evento: {
    para: "Evento", etiqueta: "Evento", nota: "Se tiver o convite ou uma referência do tema, anexe por lá.", detalhes: "Nomes, idade, número de convidados, referência…",
    grupos: [
      { campo: "Festa", legenda: "Tipo de festa", opcoes: ["Casamento", "Aniversário", "Chá de bebê", "Batizado", "Formatura", "Outra festa"] },
      { campo: "Preciso de", legenda: "O que você precisa", opcoes: ["Lembrancinhas", "Decoração da festa", "Peças personalizadas", "Outra peça"] },
      { campo: "Quantidade", legenda: "Quantidade", opcoes: ["Até 30", "30 a 80", "80 a 150", "Mais de 150"] }
    ],
    textos: [
      { campo: "Data da festa", legenda: "Data da festa", placeholder: "Ex.: 14 de dezembro" },
      { campo: "Tema e cores", legenda: "Tema e cores", placeholder: "Ex.: Safari, verde e dourado" }
    ]
  }
};
const c = CONFIG[quem];
const id = `orc-${quem}`;
---
<section class="sec" id="orcamento">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">Orçamento</span><h2>{titulo}</h2><p>{texto}</p></div>
    <div class="orc" data-orc data-para={c.para} data-base={LINKS.contato.whatsappOrcamento}>
      <form class="orc-form" novalidate>
        {c.grupos.map((g, k) => (
          <fieldset>
            <legend>{g.legenda}</legend>
            <div class="chips">{g.opcoes.map((t) => <label class="chip"><input type="radio" name={`${id}-${k}`} value={t} data-campo={g.campo}><span>{t}</span></label>)}</div>
          </fieldset>
        ))}
        {c.textos.map((t, k) => (
          <fieldset>
            <legend><label for={`${id}-t${k}`}>{t.legenda}</label></legend>
            <input type="text" id={`${id}-t${k}`} data-campo={t.campo} name={t.campo} data-junto={t.junto ? "" : undefined} placeholder={t.placeholder} autocomplete={t.auto ?? "off"}>
          </fieldset>
        ))}
        <fieldset>
          <legend><label for={`${id}-det`}>Detalhes</label></legend>
          <textarea id={`${id}-det`} name="detalhes" data-campo="Detalhes" rows="2" placeholder={c.detalhes}></textarea>
        </fieldset>
      </form>
      <div class="orc-lado">
        <div class="ticket" aria-live="polite">
          <div class="ticket-head"><span>Ordem de impressão</span><span>{c.etiqueta}</span></div>
          <dl></dl>
        </div>
        <a class="btn btn-primary facet orc-enviar" target="_blank" rel="noopener noreferrer" data-evento="enviar_orcamento" data-tipo={quem}>
          <svg width="17" height="17" aria-hidden="true"><use href="#i-whatsapp"/></svg>Enviar pelo WhatsApp
        </a>
        <p class="orc-nota">Você revisa a mensagem no WhatsApp antes de enviar. {c.nota}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .orc{display:grid;grid-template-columns:1.25fr .9fr;gap:56px;align-items:start;}
  .orc-form{display:grid;gap:28px;}
  fieldset{border:0;margin:0;padding:0;min-width:0;}
  legend{font-size:var(--fs-small);color:var(--muted);margin-bottom:12px;padding:0;}
  .chips{display:flex;flex-wrap:wrap;gap:8px;}
  .chip{position:relative;}
  .chip input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer;}
  .chip span{display:flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--line-2);font-size:14.5px;color:var(--body);transition:border-color .2s ease,background .2s ease,color .2s ease;}
  .chip input:checked + span{border-color:var(--gold);background:var(--gold-dim);color:var(--text);}
  .chip input:focus-visible + span{outline:2px solid var(--gold);outline-offset:2px;}
  input[type=text],textarea{width:100%;background:transparent;border:0;border-bottom:1px solid var(--line-2);color:var(--text);font:inherit;font-size:16px;padding:10px 0;resize:vertical;}
  /* foco: linha dourada mais grossa no lugar do contorno */
  input[type=text]:focus-visible,textarea:focus-visible{outline:none;border-bottom-color:var(--gold);box-shadow:0 1px 0 var(--gold);}
  ::placeholder{color:var(--faint);}
  .orc-lado{position:sticky;top:calc(var(--nav-h) + 24px);display:grid;gap:14px;}
  .ticket{font-family:var(--mono);font-size:13.5px;line-height:1.75;color:var(--body);background:var(--bg-2);border:1px solid var(--line-2);padding:28px 24px 22px;position:relative;
    box-shadow:0 30px 60px -30px var(--sombra-forte);}
  /* serrilhado de papel em cima e embaixo */
  .ticket::before,.ticket::after{content:"";position:absolute;left:-1px;right:-1px;height:10px;background:radial-gradient(circle at 6px -1px,var(--bg) 5px,transparent 5.5px) 0 0/12px 10px repeat-x;}
  .ticket::before{top:-1px;}
  .ticket::after{bottom:-1px;transform:scaleY(-1);}
  .ticket-head{display:flex;justify-content:space-between;color:var(--gold);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding-bottom:12px;margin-bottom:12px;border-bottom:1px dashed var(--line-2);}
  .ticket :global(dl){margin:0;display:grid;grid-template-columns:auto 1fr;gap:4px 16px;}
  .ticket :global(dt){color:var(--faint);}
  .ticket :global(dd){margin:0;color:var(--text);overflow-wrap:anywhere;}
  .ticket :global(dd.vazio){color:var(--faint);}
  .orc-enviar{width:100%;}
  .orc-nota{font-size:13px;color:var(--faint);line-height:1.5;}
  @media (max-width:980px){
    .orc{grid-template-columns:1fr;gap:36px;}
    .orc-lado{position:static;}
  }
</style>

<script>
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  document.querySelectorAll<HTMLElement>("[data-orc]").forEach((orc) => {
    const form = orc.querySelector("form")!;
    const dl = orc.querySelector(".ticket dl")!;
    const enviar = orc.querySelector<HTMLAnchorElement>(".orc-enviar")!;
    const juntos = [...form.querySelectorAll<HTMLInputElement>("[data-junto]")].map((el) => el.dataset.campo!);

    // [rótulo, valor] na ordem do formulário; campos "junto" (ex.: nome da empresa) entram no "Para"
    function linhas(): [string, string][] {
      const campos = new Map<string, string>();
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-campo]").forEach((el) => {
        const campo = el.dataset.campo!;
        if (!campos.has(campo)) campos.set(campo, "");
        if (el.type !== "radio") campos.set(campo, el.value.trim());
        else if ((el as HTMLInputElement).checked) campos.set(campo, el.value);
      });
      const extras = juntos.map((k) => campos.get(k)).filter(Boolean);
      juntos.forEach((k) => campos.delete(k));
      const para = orc.dataset.para! + (extras.length ? ` (${extras.join(", ")})` : "");
      return [["Para", para], ...campos];
    }

    function atualizar() {
      const ls = linhas();
      dl.innerHTML = ls.map(([k, v]) => `<dt>${k}</dt><dd class="${v ? "" : "vazio"}">${v ? esc(v) : "—"}</dd>`).join("");
      const msg = "Olá! Vim pelo site e quero um orçamento.\n" + ls.filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join("\n");
      enviar.href = `${orc.dataset.base}?text=${encodeURIComponent(msg)}`;
    }
    form.addEventListener("input", atualizar);
    form.addEventListener("change", atualizar);
    atualizar();

    // atalhos "Orçar brindes" etc.
    document.querySelectorAll<HTMLElement>("[data-quer]").forEach((b) => b.addEventListener("click", () => {
      const r = [...form.querySelectorAll<HTMLInputElement>("input[type=radio]")].find((x) => x.value === b.dataset.quer);
      if (r) { r.checked = true; atualizar(); }
    }));
  });
</script>
