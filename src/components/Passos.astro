---
// "Como funciona": quatro passos numerados.
interface Props { titulo: string; passos: [string, string][] }
const { titulo, passos } = Astro.props;
---
<section class="sec" id="processo">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">Como funciona</span><h2>{titulo}</h2></div>
    <ol class="passos">
      {passos.map(([t, d]) => <li class="surge"><h3>{t}</h3><p>{d}</p></li>)}
    </ol>
  </div>
</section>

<style>
  .passos{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,1fr);gap:28px;counter-reset:p;}
  li{border-top:1px solid var(--gold);padding-top:20px;counter-increment:p;}
  li::before{content:"0" counter(p);font-family:var(--mono);font-size:12px;color:var(--gold);}
  h3{font-size:20px;margin:12px 0 8px;}
  p{font-size:var(--fs-body);color:var(--muted);line-height:1.65;}
  @media (max-width:980px){ .passos{grid-template-columns:1fr 1fr;row-gap:36px;} }
  @media (max-width:760px){ .passos{grid-template-columns:1fr;} }
</style>
