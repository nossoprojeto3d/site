---
import { LINKS, url } from "../data/links";

interface Props { atual?: "inicio" | "empresas" | "eventos" | "voce" }
const { atual = "inicio" } = Astro.props;
const itens = [
  { id: "empresas", nome: "Para empresas", curto: "Empresas", href: url("empresas/") },
  { id: "eventos", nome: "Para eventos", curto: "Eventos", href: url("eventos/") },
  { id: "voce", nome: "Para você", curto: "Para você", href: url("para-voce/") }
];
---
<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href={url()} class="brand" aria-label="Nosso Projeto 3D — início">
      <img src={url("assets/logo.png")} alt="" width="254" height="300">
      <span translate="no">Nosso Projeto 3D</span>
    </a>
    <nav class="nav-links" aria-label="Páginas">
      {itens.map((i) => <a href={i.href} aria-current={atual === i.id ? "page" : undefined}>{i.nome}</a>)}
      <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer">Catálogo</a>
      <button type="button" class="nav-verse" data-abre="versiculo">Provérbios 16:3</button>
      <button type="button" class="tema" data-tema-alternar aria-label="Usar tema claro">
        <svg class="sol" width="18" height="18" aria-hidden="true"><use href="#i-sol"/></svg>
        <svg class="lua" width="18" height="18" aria-hidden="true"><use href="#i-lua"/></svg>
      </button>
    </nav>
    <div class="nav-m">
      <button type="button" class="nav-verse nav-verse-m" data-abre="versiculo">Provérbios 16:3</button>
      <button type="button" class="tema" data-tema-alternar aria-label="Usar tema claro">
        <svg class="sol" width="18" height="18" aria-hidden="true"><use href="#i-sol"/></svg>
        <svg class="lua" width="18" height="18" aria-hidden="true"><use href="#i-lua"/></svg>
      </button>
    </div>
  </div>
</header>
<!-- no celular os links ficam numa faixa abaixo do topo, que rola junto com a página -->
<nav class="nav-sub" aria-label="Páginas">
  <div class="container">
    {itens.map((i) => <a href={i.href} aria-current={atual === i.id ? "page" : undefined}>{i.curto}</a>)}
    <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer">Catálogo</a>
  </div>
</nav>

<style>
  .nav{position:sticky;top:0;z-index:50;padding-top:env(safe-area-inset-top,0px);border-bottom:1px solid transparent;
    transition:background .4s ease,border-color .4s ease;}
  .nav:global(.scrolled){background:var(--vidro);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border-bottom-color:var(--line);}
  .nav-inner{height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;gap:24px;}
  .brand{display:flex;align-items:center;gap:12px;}
  .brand img{height:30px;width:auto;}
  .brand span{font-family:var(--serif);font-size:17px;white-space:nowrap;}
  .nav-links{display:flex;align-items:center;gap:30px;}
  .nav-links a{font-size:14px;color:var(--muted);position:relative;transition:color .25s ease;}
  .nav-links a:hover,.nav-links a[aria-current]{color:var(--text);}
  .nav-links a::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease);}
  .nav-links a:hover::after,.nav-links a[aria-current]::after{transform:scaleX(1);}
  .nav-verse{font-family:var(--serif);font-style:italic;font-size:15px;color:var(--gold-2);white-space:nowrap;padding:6px 0 6px 30px;background:none;border:0;border-left:1px solid var(--line-2);cursor:pointer;transition:color .25s ease;}
  .nav-verse:hover{color:var(--text);}
  .nav-m,.nav-sub{display:none;}
  /* tema: mostra o sol no escuro (vai pro claro) e a lua no claro */
  .tema{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:none;border:1px solid var(--line-2);color:var(--gold-2);cursor:pointer;
    transition:border-color .25s ease,transform .45s var(--ease);}
  .tema:hover{border-color:var(--gold);transform:rotate(-12deg);}
  .tema .lua,:global([data-tema="claro"]) .tema .sol{display:none;}
  :global([data-tema="claro"]) .tema .lua{display:block;}

  /* até tablet: links numa faixa abaixo do topo (no tablet "Para empresas" etc. quebravam linha) */
  @media (max-width:1024px){
    .nav{--nav-h:60px;}
    .nav-links{display:none;}
    .nav-m{display:flex;align-items:center;gap:14px;}
    .nav-verse-m{padding:10px 0;border-left:0;font-size:14px;}
    .tema{width:36px;height:36px;}
    .nav-sub{display:block;border-bottom:1px solid var(--line);}
    .nav-sub .container{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding-bottom:12px;}
    .nav-sub a{flex:1 0 auto;display:flex;align-items:center;justify-content:center;height:36px;padding:0 10px;border:1px solid var(--line-2);font-size:13px;color:var(--body);}
    .nav-sub a[aria-current]{border-color:var(--gold);background:var(--gold-dim);color:var(--text);}
  }
  /* celulares estreitos: aperta o topo pra o nome caber numa linha ao lado do versículo e do tema */
  @media (max-width:400px){
    .nav-inner{gap:10px;}
    .brand{gap:9px;}
    .brand img{height:26px;}
    .brand span{font-size:15.5px;}
    .nav-m{gap:10px;}
    .nav-verse-m{font-size:13px;}
    .tema{width:34px;height:34px;}
  }
  /* telas bem antigas (320px): só o nome escrito, sem o ícone do logo */
  @media (max-width:340px){
    .brand img{display:none;}
    .brand span{font-size:15px;}
    .nav-m{gap:8px;}
  }
</style>
