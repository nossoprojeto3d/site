---
import Base from "../layouts/Base.astro";
import Topo from "../components/Topo.astro";
import Passos from "../components/Passos.astro";
import Orcamento from "../components/Orcamento.astro";
import Duvidas from "../components/Duvidas.astro";
import BarraOrcamento from "../components/BarraOrcamento.astro";
import Foto from "../components/Foto.astro";
import { LINKS } from "../data/links";

const categorias = [
  { nome: "Peças personalizadas", texto: "Presentes e peças únicas, com nome, data ou o desenho que você quiser.", foto: "12-personalizada", descricao: "peça personalizada com nome", quer: "Peça personalizada" },
  { nome: "Miniaturas", texto: "Colecionáveis, personagens e brinquedos, nos detalhes.", foto: "13-miniatura", descricao: "miniatura pintada", quer: "Miniatura" },
  { nome: "Decoração", texto: "Vasos, luminárias e objetos para deixar a casa com a sua cara.", foto: "14-decoracao", descricao: "vaso ou luminária", quer: "Decoração" },
  { nome: "Organização", texto: "Organizadores, suportes e utilidades sob medida para o seu espaço.", foto: "15-organizacao", descricao: "organizador de gaveta", quer: "Organizador ou suporte" }
];

const passos: [string, string][] = [
  ["Conte sua ideia", "Mande fotos, medidas ou referências pelo WhatsApp."],
  ["Orçamento", "Sugerimos material e cor, e passamos valor e prazo."],
  ["Impressão", "Sua peça é impressa camada por camada, com cuidado no acabamento."],
  ["Entrega", "Retire ou receba em Goiânia e região, ou enviamos para todo o Brasil."]
];

const faq: [string, string][] = [
  ["Qual o prazo de uma peça?", "Peças avulsas costumam ficar prontas de 3 a 7 dias, dependendo do tamanho e do acabamento."],
  ["Preciso ter o arquivo 3D?", "Não. Pode mandar uma foto, um desenho ou só a ideia: a gente modela pra você."],
  ["Dá pra escolher a cor?", "Sim. Trabalhamos com PLA e PETG em várias cores. Mostramos as opções no orçamento."],
  ["Fazem peça de reposição?", "Sim: encaixes, suportes e peças que quebraram. Mande foto e medidas que a gente avalia."],
  ["Como funciona a entrega?", "Entregamos ou combinamos a retirada em Goiânia e região, e enviamos para todo o Brasil."]
];
---
<Base
  titulo="Peças 3D personalizadas, miniaturas e decoração — Nosso Projeto 3D"
  descricao="Peças sob medida, miniaturas, decoração e organizadores em impressão 3D. Peça pelo WhatsApp. Goiânia-GO, com envio para todo o Brasil."
  atual="voce"
>
  <Topo
    rotulo="Para você"
    titulo="Do que você imaginou ao que você precisa."
    texto="Peças sob medida, miniaturas, decoração e organizadores. Conte a ideia e a gente transforma em algo real."
  >
    <a href="#orcamento" class="btn btn-primary facet">Pedir uma peça sob medida</a>
    <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer" class="btn btn-ghost facet">Ver catálogo <svg width="16" height="16" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    <div class="container" slot="depois">
      <ul class="vitrine">
        {categorias.map((c) => (
          <li class="item">
            <Foto arquivo={c.foto} descricao={c.descricao} />
            <h2>{c.nome}</h2>
            <p>{c.texto}</p>
            <a href="#orcamento" class="item-link" data-quer={c.quer}>Pedir {c.nome.toLowerCase()} <svg width="16" height="16" aria-hidden="true"><use href="#i-right"/></svg></a>
          </li>
        ))}
      </ul>
    </div>
  </Topo>

  <Passos titulo="Da ideia à peça pronta, em quatro passos." passos={passos} />
  <Orcamento quem="pessoa" titulo="Conte o que você imaginou." texto="Escolha as opções e a mensagem vai pronta para o nosso WhatsApp. Respondemos com valor e prazo." />
  <Duvidas itens={faq} />
  <BarraOrcamento slot="fim" texto="Peças sob medida pelo WhatsApp." />
</Base>

<style>
  .vitrine{list-style:none;--borda:max(var(--gutter),calc((100vw - var(--max)) / 2 + var(--gutter)));
    display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--borda);
    margin:72px calc(50% - 50vw) 0;padding:0 var(--borda) 6px;scrollbar-width:none;}
  .vitrine::-webkit-scrollbar{display:none;}
  .item{flex:0 0 min(76vw,320px);scroll-snap-align:start;display:flex;flex-direction:column;}
  .item h2{margin-top:18px;font-size:var(--fs-h3);}
  .item p{margin-top:8px;color:var(--muted);font-size:var(--fs-body);line-height:1.6;}
  .item-link{margin-top:14px;display:inline-flex;align-items:center;gap:8px;color:var(--gold-2);font-size:var(--fs-body);font-weight:500;}
  .item-link svg{transition:transform .3s var(--ease);}
  .item-link:hover svg{transform:translateX(4px);}
  @media (min-width:1200px){
    /* no computador as quatro categorias cabem lado a lado, sem carrossel */
    .vitrine{margin-inline:0;padding-inline:0;overflow:visible;}
    .item{flex:1 1 0;}
  }
  @media (max-width:760px){ .vitrine{margin-top:48px;} }
</style>
