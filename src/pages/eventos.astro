---
import Base from "../layouts/Base.astro";
import Topo from "../components/Topo.astro";
import Oferta, { type OfertaDados } from "../components/Oferta.astro";
import Passos from "../components/Passos.astro";
import Orcamento from "../components/Orcamento.astro";
import Duvidas from "../components/Duvidas.astro";
import BarraOrcamento from "../components/BarraOrcamento.astro";

const festas = ["Casamento", "Aniversário", "15 anos", "Chá de bebê", "Chá revelação", "Batizado", "Primeira comunhão", "Formatura", "Bodas", "Confraternização"];

const ofertas: OfertaDados[] = [
  {
    id: "lembrancinhas",
    titulo: "Lembrancinhas",
    texto: "A lembrança que o convidado leva pra casa e guarda. Feita no tema da festa, com o nome de quem celebra.",
    itens: ["Chaveiros, ímãs, porta-retratos e mini-vasos", "Com nome, data, idade ou o personagem da festa", "Nas cores da paleta do convite"],
    ph: "A partir de 30 unidades",
    fotos: [["06-lembrancinhas-mesa", "lembrancinhas de chá de bebê na mesa"], ["07-chaveiros-festa", "chaveiros com nome e data da festa"]],
    quer: "Lembrancinhas",
    botao: "Orçar lembrancinhas"
  },
  {
    id: "decoracao",
    titulo: "Decoração da festa",
    texto: "Peças que completam a mesa do bolo e o salão, no tema e na paleta da festa.",
    itens: ["Letreiros e nomes em relevo", "Centros de mesa e plaquinhas de mesa numeradas", "Personagens e elementos do tema em tamanho de mesa"],
    ph: "Prévia digital antes de produzir",
    fotos: [["08-letreiro-nome", "letreiro com o nome do aniversariante"], ["09-mesa-tema", "mesa decorada com peças do tema"]],
    quer: "Decoração da festa",
    botao: "Orçar decoração"
  },
  {
    id: "personalizados",
    titulo: "Personalizados no tema",
    texto: "Do casamento clássico ao aniversário de super-herói: cada peça segue o tema, as cores e o estilo da festa.",
    itens: ["Cores escolhidas a partir do convite ou da paleta", "Nomes, iniciais, datas e idades", "Peças especiais para padrinhos, pais e equipe"],
    fotos: [["10-cores-convite", "peça nas cores do convite"], ["11-kit-padrinhos", "kit para padrinhos"]],
    quer: "Peças personalizadas",
    botao: "Orçar personalizados"
  }
];

const passos: [string, string][] = [
  ["Conte sobre a festa", "Data, tema, cores e número de convidados pelo WhatsApp."],
  ["Proposta e prévia", "Sugerimos as peças, passamos valor e prazo e mostramos a prévia."],
  ["Produção", "Imprimimos tudo com antecedência e conferimos peça por peça."],
  ["Entrega antes da festa", "Em Goiânia e região, ou enviamos com folga para a data."]
];

const faq: [string, string][] = [
  ["Com quanta antecedência devo pedir?", "Para lembrancinhas, o ideal é pedir com pelo menos 3 semanas. Peças de decoração podem ser combinadas em menos tempo, conforme a agenda."],
  ["Qual a quantidade mínima de lembrancinhas?", "A partir de 30 unidades. Peças de decoração podem ser feitas a partir de 1 unidade."],
  ["Dá pra seguir as cores e o tema da festa?", "Sim. Mande o convite ou a paleta e escolhemos as cores mais próximas entre os nossos filamentos."],
  ["Vocês colocam nome, data e idade?", "Sim. Nomes, iniciais, datas e idades entram na própria peça, em relevo."],
  ["Vocês entregam no local da festa?", "Em Goiânia e região, combinamos a entrega ou a retirada. Para outras cidades, enviamos com antecedência."]
];
---
<Base
  titulo="Lembrancinhas e decoração de festa em impressão 3D — Nosso Projeto 3D"
  descricao="Lembrancinhas e decoração personalizada no tema da sua festa: casamento, aniversário, chá de bebê, batizado e formatura. Goiânia-GO, com envio para todo o Brasil."
  atual="eventos"
>
  <Topo
    rotulo="Para eventos"
    titulo="Lembrancinhas e decoração no tema da sua festa."
    texto="Casamentos, aniversários, chás e batizados: peças personalizadas nas cores, no tema e com o nome de quem celebra."
  >
    <a href="#orcamento" class="btn btn-primary facet">Pedir orçamento</a>
    <a href="#lembrancinhas" class="btn btn-ghost facet">Ver ideias</a>
    <div class="festas-caixa" slot="depois">
      <div class="festas" aria-label="Celebrações que atendemos">
        <ul class="faixa">
          {festas.map((f) => <li>{f}</li>)}
        </ul>
        {/* cópia da faixa pra rolagem contínua (escondida de leitores de tela) */}
        <ul class="faixa" aria-hidden="true">
          {festas.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <button type="button" class="pausa" id="pausa-festas" aria-pressed="false" aria-label="Pausar a faixa de celebrações">
        <svg class="i-pausa" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor"/></svg>
        <svg class="i-tocar" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
      </button>
    </div>
  </Topo>

  {ofertas.map((o, i) => <Oferta oferta={o} inverte={i % 2 === 1} />)}
  <Passos titulo="Da ideia à mesa da festa." passos={passos} />
  <Orcamento quem="evento" titulo="Conte como vai ser a festa." texto="Escolha as opções e a mensagem vai pronta para o nosso WhatsApp. Respondemos com valor, prazo e uma prévia." />
  <Duvidas itens={faq} />
  <BarraOrcamento slot="fim" texto="Lembrancinhas e decoração no tema da festa." />
</Base>

<style>
  /* faixa de celebrações passando devagar; para no hover e com "reduzir movimento" */
  .festas-caixa{position:relative;margin-top:80px;}
  .festas{display:flex;overflow:hidden;border-block:1px solid var(--line);padding:22px 0;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);}
  .faixa{flex:0 0 auto;display:flex;list-style:none;margin:0;padding:0;animation:passa 48s linear infinite;}
  .festas:hover .faixa,.festas-caixa.parada .faixa{animation-play-state:paused;}
  /* botão de pausar: animação contínua precisa de controle (também no celular, onde não há hover) */
  .pausa{position:absolute;right:var(--gutter);top:50%;transform:translateY(-50%);width:36px;height:36px;display:flex;align-items:center;justify-content:center;
    border:1px solid var(--line-2);background:var(--bg);color:var(--gold-2);cursor:pointer;transition:border-color .25s ease;}
  .pausa:hover{border-color:var(--gold);}
  .pausa .i-tocar,.parada .pausa .i-pausa{display:none;}
  .parada .pausa .i-tocar{display:block;}
  .faixa li{font-family:var(--serif);font-style:italic;font-size:clamp(24px,2vw + 14px,38px);color:var(--text);white-space:nowrap;display:flex;align-items:center;}
  .faixa li::after{content:"";width:7px;height:7px;border-radius:50%;background:var(--gold);margin:0 34px;}
  @keyframes passa{to{transform:translateX(-100%);}}
  @media (max-width:760px){ .festas-caixa{margin-top:56px;} .festas{padding:16px 0;} .faixa li::after{margin:0 22px;} .pausa{right:12px;width:32px;height:32px;} }
  @media (prefers-reduced-motion:reduce){
    .festas{overflow-x:auto;}
    .faixa{animation:none;}
    .faixa[aria-hidden="true"]{display:none;}
    .pausa{display:none;}
  }
</style>

<script>
  const caixa = document.querySelector(".festas-caixa")!;
  const botao = document.getElementById("pausa-festas")!;
  botao.addEventListener("click", () => {
    const parada = caixa.classList.toggle("parada");
    botao.setAttribute("aria-pressed", String(parada));
    botao.setAttribute("aria-label", parada ? "Continuar a faixa de celebrações" : "Pausar a faixa de celebrações");
  });
</script>
