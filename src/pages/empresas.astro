---
import Base from "../layouts/Base.astro";
import Topo from "../components/Topo.astro";
import Oferta, { type OfertaDados } from "../components/Oferta.astro";
import Passos from "../components/Passos.astro";
import Orcamento from "../components/Orcamento.astro";
import Duvidas from "../components/Duvidas.astro";
import BarraOrcamento from "../components/BarraOrcamento.astro";

const ofertas: OfertaDados[] = [
  {
    id: "brindes",
    titulo: "Brindes com logo",
    texto: "Para eventos, clientes e equipe: um brinde útil, que fica na mesa e lembra a sua marca todos os dias.",
    itens: ["Chaveiros, porta-cartões, porta-celular e marcadores", "Logo em relevo e nas cores da sua marca", "Kits montados para eventos e datas comemorativas"],
    ph: "Pedidos a partir de 20 unidades",
    fotos: [["02-chaveiro-logo", "chaveiro com o logo da empresa Starlink MG, em azul, branco, verde e amarelo"], ["03-caixa-embalagem", "caixa de papel kraft com o logo da Nosso Projeto 3D, usada para embalar os pedidos"]],
    quer: "Brindes com logo",
    botao: "Orçar brindes"
  },
  {
    id: "expositores",
    titulo: "Expositores e displays",
    texto: "Suportes de produto, displays de balcão e placas para deixar o seu ponto de venda organizado e com a sua identidade.",
    itens: ["Feitos sob medida para o seu produto e o seu espaço", "Displays de balcão, suportes e placas com nome", "Nas cores da marca, com a logo aplicada"],
    ph: "Prévia digital antes de produzir",
    fotos: [["04-display-balcao", "display de balcão preto e branco com QR code do PIX, logo da empresa e botões de Instagram, WhatsApp e site"], ["05-letreiro-balcao", "letreiro de balcão branco e rosa com o nome Maylla, os dizeres Artes em crochê e um coração de novelo"]],
    quer: "Expositor ou display",
    botao: "Orçar expositores"
  }
];

const passos: [string, string][] = [
  ["Você manda a ideia", "Logo, quantidade e prazo pelo WhatsApp. Pode ser só uma referência."],
  ["Orçamento e prévia", "Passamos valor e prazo, e mostramos como a peça vai ficar."],
  ["Produção", "Imprimimos o lote e conferimos o acabamento peça por peça."],
  ["Entrega", "Entregamos em Goiânia e região, ou enviamos para todo o Brasil."]
];

const faq: [string, string][] = [
  ["Qual a quantidade mínima?", "Para brindes com logo, a partir de 20 unidades. Expositores e placas podem ser feitos a partir de 1 unidade."],
  ["Qual o prazo de um lote?", "Depende da peça e da quantidade. Um lote de brindes costuma levar de 7 a 15 dias depois da aprovação."],
  ["Preciso ter o arquivo 3D?", "Não. Mande a logo (de preferência em PNG ou vetor) e a ideia: a gente modela e mostra a prévia."],
  ["Dá pra usar as cores da minha marca?", "Sim. Trabalhamos com PLA e PETG em várias cores e escolhemos as mais próximas da sua identidade."],
  ["Vocês entregam fora de Goiânia?", "Sim. Entregamos em Goiânia e região e enviamos para todo o Brasil."]
];
---
<Base
  titulo="Brindes com logo e expositores em impressão 3D — Nosso Projeto 3D"
  descricao="Brindes personalizados com a logo da sua empresa e expositores sob medida para o seu ponto de venda. Impressão 3D em Goiânia, com envio para todo o Brasil."
  atual="empresas"
>
  <Topo
    rotulo="Para empresas"
    titulo="Brindes e expositores com a cara da sua marca."
    texto="Produzimos em quantidade, com a sua logo e nas cores da sua identidade. Você pede pelo WhatsApp e acompanha tudo com a gente."
  >
    <a href="#orcamento" class="btn btn-primary facet">Pedir orçamento</a>
    <a href="#brindes" class="btn btn-ghost facet">Ver soluções</a>
  </Topo>

  {ofertas.map((o, i) => <Oferta oferta={o} inverte={i % 2 === 1} />)}
  <Passos titulo="Da sua logo ao lote pronto." passos={passos} />
  <Orcamento quem="empresa" titulo="Conte o que a sua empresa precisa." texto="Escolha as opções e a mensagem vai pronta para o nosso WhatsApp. Respondemos com valor, prazo e uma prévia." />
  <Duvidas itens={faq} />
  <BarraOrcamento slot="fim" texto="Brindes e expositores com a sua logo." />
</Base>
